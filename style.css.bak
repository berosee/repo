body{
background:#111;
color:white;
font-family:Arial;
text-align:center;
}

.menu button{

padding:12px 22px;
margin:6px;
font-size:18px;

border-radius:20px;
border:none;

background:#444;
color:white;

cursor:pointer;

}

.menu button:hover{
background:#666;
}

.menu button.active{
background:#2b6cff;
}

audio{
width:80%;
margin:15px;
}

.controls button{
padding:8px 16px;
margin:5px;
}

#playlist{
height:350px;
overflow:auto;
border:1px solid #333;
margin-top:20px;
}

.song{
padding:6px;
cursor:pointer;
}

.song:hover{
background:#333;
}

#search{
margin-top:10px;
padding:8px;
width:250px;
}
audio{
width:60%;
max-width:700px;
margin:20px;
}

@media (max-width:700px){

audio{
width:95%;
}

.menu button{
font-size:20px;
padding:14px 24px;
}

.song{
font-size:18px;
}

#search{
width:80%;
font-size:18px;
}
}
/* 모바일 전용 확대 */
@media (max-width:700px){

body{
font-size:20px;
}

.song{
font-size:20px;
}

.menu button{
font-size:20px;
padding:14px 26px;
}

#search{
font-size:20px;
width:85%;
}

/* 플레이어 시간 글씨 크게 */
audio{
width:95%;
height:55px;
}

}